<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <title>Site Analytics - Beacon</title>
  <%- include('partials/_head') %>
</head>
<body>
  <div class="app-wrapper">
    <%- include('partials/_sidebar', { user: user, currentPath: '/analytics' }) %>
    
    <main class="main-content">
      <%- include('partials/_topbar', { user: user, pageTitle: 'Site Analytics' }) %>
      
      <div class="page-container">
        <!-- Page Header -->
        <div class="page-header">
          <div class="page-header-top">
            <div>
              <h1 class="page-title">Site Analytics</h1>
              <p class="page-description">Performance overview for all your registered sites</p>
            </div>
            <div class="flex gap-sm">
              <select id="siteFilter" class="form-select">
                <option value="">All Sites</option>
                <% if (analyticsData && analyticsData.length > 0) { %>
                  <% analyticsData.forEach(function(site) { %>
                    <option value="<%= site.siteCode %>"><%= site.siteCode %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
          </div>
        </div>

        <!-- Overall Stats -->
        <div class="grid grid-cols-4 mb-lg">
          <div class="stat-card">
            <div class="stat-card-icon" style="background-color: var(--color-primary-light);">
              <i data-lucide="bar-chart-2" style="color: var(--color-primary);"></i>
            </div>
            <div class="stat-card-content">
              <div class="stat-card-value" id="totalInteractions">
                <% 
                  let totalInteractions = 0;
                  if (analyticsData && analyticsData.length > 0) {
                    analyticsData.forEach(site => totalInteractions += site.interactions || 0);
                  }
                %>
                <%= totalInteractions %>
              </div>
              <div class="stat-card-label">Total Interactions</div>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-card-icon" style="background-color: #dcfce7;">
              <i data-lucide="eye" style="color: #16a34a;"></i>
            </div>
            <div class="stat-card-content">
              <div class="stat-card-value" id="totalOpens">
                <% 
                  let totalOpens = 0;
                  if (analyticsData && analyticsData.length > 0) {
                    analyticsData.forEach(site => totalOpens += site.open_count || 0);
                  }
                %>
                <%= totalOpens %>
              </div>
              <div class="stat-card-label">Total Opens</div>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-card-icon" style="background-color: #fef3c7;">
              <i data-lucide="mouse-pointer-click" style="color: #f59e0b;"></i>
            </div>
            <div class="stat-card-content">
              <div class="stat-card-value" id="totalClicks">
                <% 
                  let totalClicks = 0;
                  if (analyticsData && analyticsData.length > 0) {
                    analyticsData.forEach(site => totalClicks += site.click_count || 0);
                  }
                %>
                <%= totalClicks %>
              </div>
              <div class="stat-card-label">Total Clicks</div>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-card-icon" style="background-color: #e0e7ff;">
              <i data-lucide="users" style="color: var(--color-secondary);"></i>
            </div>
            <div class="stat-card-content">
              <div class="stat-card-value" id="totalSubscribers">
                <% 
                  let totalSubscribers = 0;
                  if (analyticsData && analyticsData.length > 0) {
                    analyticsData.forEach(site => totalSubscribers += site.active_subscribers || 0);
                  }
                %>
                <%= totalSubscribers %>
              </div>
              <div class="stat-card-label">Active Subscribers</div>
            </div>
          </div>
        </div>

        <!-- Site Performance Table -->
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">
              <i data-lucide="activity" style="width: 20px; height: 20px; display: inline-block; vertical-align: middle; margin-right: 8px;"></i>
              Site Performance
            </h3>
          </div>
          <div class="card-body" style="padding: 0;">
            <table class="table">
              <thead>
                <tr>
                  <th>Site Code</th>
                  <th>Interactions</th>
                  <th>Opens</th>
                  <th>Clicks</th>
                  <th>Conversions</th>
                  <th>Subscribers</th>
                  <th>CTR</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="analyticsTableBody">
                <% if (analyticsData && analyticsData.length > 0) { %>
                  <% analyticsData.forEach(function(site) { %>
                    <% 
                      const ctr = site.open_count > 0 ? ((site.click_count / site.open_count) * 100).toFixed(1) : 0;
                    %>
                    <tr data-site="<%= site.siteCode %>">
                      <td>
                        <div class="flex align-center gap-sm">
                          <i data-lucide="globe" style="width: 16px; height: 16px; color: var(--color-primary);"></i>
                          <strong><%= site.siteCode %></strong>
                        </div>
                      </td>
                      <td><%= site.interactions || 0 %></td>
                      <td>
                        <span class="badge badge-success"><%= site.open_count || 0 %></span>
                      </td>
                      <td>
                        <span class="badge badge-info"><%= site.click_count || 0 %></span>
                      </td>
                      <td>
                        <span class="badge badge-warning"><%= site.conversion_count || 0 %></span>
                      </td>
                      <td><%= site.active_subscribers || 0 %></td>
                      <td>
                        <div class="flex align-center gap-sm">
                          <div style="flex: 1; height: 6px; background: var(--color-bg-tertiary); border-radius: 3px; overflow: hidden;">
                            <div style="<%- `height: 100%; background: var(--color-success); width: ${ctr}%` %>"></div>
                          </div>
                          <span style="font-size: 13px; font-weight: 500;"><%= ctr %>%</span>
                        </div>
                      </td>
                      <td>
                        <div class="flex gap-xs">
                          <a href="/analytics-dashboard?site=<%= site.siteCode %>" class="btn btn-sm btn-secondary">
                            <i data-lucide="trending-up" style="width: 14px; height: 14px;"></i>
                            Details
                          </a>
                          <a href="/send-notification/<%= site.siteCode %>" class="btn btn-sm btn-primary">
                            <i data-lucide="send" style="width: 14px; height: 14px;"></i>
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="8" style="text-align: center; padding: var(--space-xl);">
                      <i data-lucide="inbox" style="width: 48px; height: 48px; color: var(--color-text-tertiary); margin-bottom: var(--space-md);"></i>
                      <p style="color: var(--color-text-secondary);">No analytics data available</p>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Quick Stats Grid -->
        <div class="grid grid-cols-2 mt-lg">
          <!-- Engagement Chart -->
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">
                <i data-lucide="zap" style="width: 20px; height: 20px; display: inline-block; vertical-align: middle; margin-right: 8px;"></i>
                Engagement Overview
              </h3>
            </div>
            <div class="card-body">
              <canvas id="engagementChart" style="max-height: 300px;"></canvas>
            </div>
          </div>

          <!-- Top Performing Sites -->
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">
                <i data-lucide="trophy" style="width: 20px; height: 20px; display: inline-block; vertical-align: middle; margin-right: 8px;"></i>
                Top Performing Sites
              </h3>
            </div>
            <div class="card-body">
              <div style="display: flex; flex-direction: column; gap: var(--space-md);">
                <% 
                  if (analyticsData && analyticsData.length > 0) {
                    const sortedSites = [...analyticsData].sort((a, b) => (b.interactions || 0) - (a.interactions || 0)).slice(0, 5);
                    sortedSites.forEach(function(site, index) {
                      const percentage = analyticsData.length > 0 ? ((site.interactions / analyticsData.reduce((sum, s) => sum + (s.interactions || 0), 0)) * 100).toFixed(0) : 0;
                %>
                  <div>
                    <div class="flex justify-between mb-xs">
                      <span class="text-sm font-medium"><%= site.siteCode %></span>
                      <span class="text-sm text-secondary"><%= site.interactions || 0 %> interactions</span>
                    </div>
                    <div style="height: 8px; background: var(--color-bg-tertiary); border-radius: 4px; overflow: hidden;">
                      <div style="<%- `height: 100%; background: var(--color-primary); width: ${percentage}%` %>"></div>
                    </div>
                  </div>
                <% 
                    });
                  } else {
                %>
                  <p class="text-secondary text-center">No data available</p>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }

    // Site filter functionality
    document.getElementById('siteFilter').addEventListener('change', function(e) {
      const selectedSite = e.target.value;
      const rows = document.querySelectorAll('#analyticsTableBody tr[data-site]');
      
      rows.forEach(row => {
        if (!selectedSite || row.dataset.site === selectedSite) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });

    // Engagement Chart
    const analyticsData = JSON.parse('<%- JSON.stringify(analyticsData || []).replace(/</g, "\\u003c") %>');
    
    if (analyticsData.length > 0) {
      const ctx = document.getElementById('engagementChart').getContext('2d');
      new Chart(ctx, {
        type: 'bar',
        data: {
          labels: analyticsData.map(site => site.siteCode),
          datasets: [
            {
              label: 'Opens',
              data: analyticsData.map(site => site.open_count || 0),
              backgroundColor: 'rgba(34, 197, 94, 0.5)',
              borderColor: 'rgba(34, 197, 94, 1)',
              borderWidth: 1
            },
            {
              label: 'Clicks',
              data: analyticsData.map(site => site.click_count || 0),
              backgroundColor: 'rgba(59, 130, 246, 0.5)',
              borderColor: 'rgba(59, 130, 246, 1)',
              borderWidth: 1
            },
            {
              label: 'Conversions',
              data: analyticsData.map(site => site.conversion_count || 0),
              backgroundColor: 'rgba(168, 85, 247, 0.5)',
              borderColor: 'rgba(168, 85, 247, 1)',
              borderWidth: 1
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: {
              beginAtZero: true
            }
          },
          plugins: {
            legend: {
              position: 'bottom'
            }
          }
        }
      });
    }
  </script>
</body>
</html>
